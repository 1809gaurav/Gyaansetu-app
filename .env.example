# ---------------------------------------------------------------------------
# Backend (Render) variables
# ---------------------------------------------------------------------------
NODE_ENV=production
# Render provides PORT automatically; only needed for local production runs.
PORT=5000

# Comma-separated list of frontend origins allowed to call this API.
# Leave empty to allow any origin (convenient for development only).
CORS_ORIGIN=http://localhost:5000

# Optional: enables the AI assistant endpoints (currently mock responses).
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Frontend (Vercel) variables - set these in the Vercel project settings
# ---------------------------------------------------------------------------
# Public URL of the Render backend. Leave empty when frontend and backend
# share the same origin (i.e. the whole app is deployed on Render).
VITE_API_URL=https://your-render-service.onrender.com
